# =========================================
# PK Sompura Backend — Environment Variables
# Copy this file to backend/.env and fill in values.
# This file stays on the server and is never bundled or served.
# =========================================

# --- Admin panel (/admin) ---
# The password is stored only as a scrypt hash, never in plaintext, so a
# leaked env file does not hand over the password itself. Generate one:
#
#   python -m backend.security              (random strong password)
#   python -m backend.security "my-pass"    (hash a chosen password)
#
# There is no default. If ADMIN_PASSWORD_HASH is unset the panel rejects
# every login, because it has full write access to all models and a known
# fallback credential would be an open door. Logins are rate limited to
# 5 failures per client per 5 minutes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Signs admin session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random one is generated per process, so sessions are dropped
# on every restart and will not work across multiple workers.
SESSION_SECRET=

# Set to true when serving over HTTPS so session cookies are secure-only.
SESSION_HTTPS_ONLY=false

# --- CORS ---
# Comma-separated list of front-end origins allowed to call this API.
# Do not use "*": browsers reject a wildcard when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (server side) ---
SUPABASE_URL=https://your-project-id.supabase.co

# Admin image uploads write to the "temples" and "team" storage buckets.
# Those buckets allow public READ but have no write policy, so only the
# service-role key can upload. The anon key is rejected by RLS.
# Dashboard > Project Settings > API keys > service_role (click Reveal).
# Server-side only. Never expose it as a VITE_ variable.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- Database ---
DATABASE_URL=sqlite:///./pk_sompura.db

# --- Inquiry delivery (Telegram) ---
# Server-side only. Never expose as VITE_*: a leaked bot token lets anyone
# post as the bot and read its chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
