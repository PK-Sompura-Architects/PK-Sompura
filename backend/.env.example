# =========================================
# PK Sompura Backend — Environment Variables
# Copy this file to backend/.env and fill in values.
# This file stays on the server and is never bundled or served.
# =========================================

# --- Admin panel (/admin) ---
# There is no default password. If ADMIN_PASSWORD is unset the panel
# rejects every login, because the panel has full write access to all
# models and a known fallback credential would be an open door.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs admin session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random one is generated per process, so sessions are dropped
# on every restart and will not work across multiple workers.
SESSION_SECRET=

# Set to true when serving over HTTPS so session cookies are secure-only.
SESSION_HTTPS_ONLY=false

# --- CORS ---
# Comma-separated list of front-end origins allowed to call this API.
# Do not use "*": browsers reject a wildcard when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (server side) ---
# Used by the admin panel to upload images to the "team" and "temples"
# buckets. This key is never sent to the browser.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_key_here

# --- Database ---
DATABASE_URL=sqlite:///./pk_sompura.db

# --- Inquiry delivery (Telegram) ---
# Server-side only. Never expose as VITE_*: a leaked bot token lets anyone
# post as the bot and read its chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
