venv/
__pycache__/
.env
node_modules/

# Generated codebase bundles (bundle.py / split_bundle.py output)
project_bundle.txt
project_bundle_part_*.txt
master_codebase.txt

# Build artifacts
frontend/.next/
frontend/dist/
*.tsbuildinfo

# Local database (kept on disk, not tracked)
pk_sompura.db

# Env backups
.env.*
!.env.example

# Working photos for headshot processing (not shipped to the site)
headshots/

# Raw photo libraries live outside the repo; only the processed web copies
# under frontend/public/media are committed.
ALBUM-IMAGES/
*.NEF
*.CR2
*.dng

# graphify knowledge-graph output (regenerate with /graphify)
graphify-out/

# Photos dropped into the repo root from a phone. They are working material,
# often family photographs, and must never be committed. Kept as a pattern
# rather than a one-off filename because the next one will have a new date.
WhatsApp Image *
WhatsApp Video *
IMG_*.jpg
IMG_*.jpeg
IMG_*.png
/*.jpg
/*.jpeg
/*.png
/*.webp
