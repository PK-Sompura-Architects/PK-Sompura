# =========================================
# PK Sompura Frontend — Environment Variables
# Copy this file to .env and fill in values
# DO NOT commit .env to version control
# =========================================

# --- Backend API ---
VITE_API_BASE_URL=http://localhost:8000

# --- Telegram Bot (Task 1: Inquiry Form) ---
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Supabase (Task 4: Admin Panel) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Admin Password (Task 4: Admin Login Gate) ---
# Change this to a strong password before deploying
VITE_ADMIN_PASSWORD=admin123
