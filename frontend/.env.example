# =========================================
# PK Sompura Frontend — Environment Variables
# Copy this file to .env and fill in values
# =========================================
#
# !! READ THIS BEFORE ADDING ANYTHING !!
#
# Vite inlines every VITE_* value into the JavaScript bundle at BUILD time.
# Anything here is shipped to the browser in plain text and is readable by
# anyone who opens devtools. It is public configuration, not secrets.
#
# Never put here: admin passwords, service-role keys, bot tokens, API secrets.
# Those belong on the server (see backend/.env.example).

# --- Backend API ---
# The ONLY VITE_* variable this front end reads. Verified: it is the single
# `import.meta.env.VITE_*` reference in src/, in src/apiBase.js.
#
# Leave it EMPTY on Netlify and Vercel. Both hosts proxy /api and /admin to
# Render (netlify.toml / vercel.json), so a relative base keeps the calls
# same-origin and avoids a CORS preflight entirely. Setting it to the Render
# URL works against that: the browser would then call Render directly and need
# the origin listed in ALLOWED_ORIGINS.
#
# Only set it when a deploy genuinely talks to a backend on another host with
# no proxy in front of it.
VITE_API_BASE_URL=

# --- No Supabase variables ---
# This file used to list VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY. Nothing
# reads them: @supabase/supabase-js is not a front-end dependency and the
# string "supabase" does not appear anywhere in src/. The browser never talks
# to Supabase -- it talks to FastAPI, which owns the database connection.
# Removed rather than left, because a deployment guide that says "add every
# VITE_* variable the site uses" would otherwise have you paste an anon key
# into a host for no reason.
