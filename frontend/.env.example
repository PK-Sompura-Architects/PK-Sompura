# =========================================
# PK Sompura Frontend — Environment Variables
# Copy this file to .env and fill in values
# =========================================
#
# !! READ THIS BEFORE ADDING ANYTHING !!
#
# Vite inlines every VITE_* value into the JavaScript bundle at BUILD time.
# Anything here is shipped to the browser in plain text and is readable by
# anyone who opens devtools. It is public configuration, not secrets.
#
# Never put here: admin passwords, service-role keys, bot tokens, API secrets.
# Those belong on the server (see backend/.env.example).

# --- Backend API ---
# Empty string uses same-origin + the dev proxy in vite.config.js.
VITE_API_BASE_URL=

# --- Supabase (public client) ---
# The anon key is designed to be public, but ONLY if Row Level Security is
# enabled on every table and storage bucket it can reach. Without RLS this
# key lets any visitor read, write and delete your data.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
