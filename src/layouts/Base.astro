---
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { contact, type NavKey } from '../data/site';
// Preloaded so they don't wait for the CSS: the heading face (every h1, often the LCP) and the body face (its late
// swap shifted the layout under the h1, CLS 0.034 on /contact).
import caslon from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url';
import hanken from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'night';
  current?: NavKey;
  image?: string; // link-preview image, 1200 × 630 (tools/og/render.mjs); the site card by default
  imageAlt?: string;
}
const {
  title,
  description = 'P.K. Sompura, temple architects and contractors in Palitana, Gujarat. Hand carving, CNC stone work and artificial mountain temples.',
  theme = 'light',
  current,
  image = '/og/default.jpg',
  imageAlt = 'P.K. Sompura, Temple Architect & Contractor, Palitana, Gujarat: Where Devotion Meets Stone.',
} = Astro.props;
// Absolute URLs from the one site address in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const street = contact.address.slice(0, 3).join(', ');             // the last line is 'Palitana 364270, Gujarat'
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'P.K. Sompura',
  description: 'Temple architects and contractors in Palitana, Gujarat: design, hand carving, CNC stone work and artificial mountain temples.',
  url: new URL('/', Astro.site).href,
  logo: new URL('/logo.webp', Astro.site).href,
  image: new URL('/og/default.jpg', Astro.site).href,
  telephone: contact.phoneHref.replace('tel:', ''),
  email: contact.email,
  address: { '@type': 'PostalAddress', streetAddress: street, addressLocality: 'Palitana', postalCode: '364270', addressRegion: 'Gujarat', addressCountry: 'IN' },
  sameAs: [contact.instagramHref],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="P.K. Sompura" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <meta name="theme-color" content={theme === 'night' ? '#0E0E1F' : '#F4EFE6'} />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="preload" as="font" type="font/woff2" href={caslon} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={hanken} crossorigin />
    {/* Light pages' h1 is .text-cut: its letters are this texture, so the h1 (LCP) can't paint before it arrives. */}
    {theme === 'light' && <link rel="preload" as="image" href="/tex/cut.webp" fetchpriority="high" />}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Loader: every full load and reload; not when arriving by an internal link, nor in ?still= poster renders.
      (() => {
        const nav = performance.getEntriesByType('navigation')[0];
        let internal = false;
        try { internal = new URL(document.referrer).origin === location.origin; } catch {}
        if (!(nav && nav.type === 'navigate' && internal) && !location.search.includes('still='))
          document.documentElement.classList.add('pk-ld');
      })();
    </script>
    <style is:inline>
      #pk-ld { display: none; }
      .pk-ld #pk-ld { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; align-items: center;
        justify-content: center; gap: 24px; background: #F4EFE6; transition: opacity 300ms ease; }
      #pk-ld .pk-ld-mark { position: relative; height: min(40vh, 280px); aspect-ratio: 442 / 565; }
      #pk-ld svg, #pk-ld img { position: absolute; inset: 0; width: 100%; height: 100%; }
      #pk-ld path { stroke-dasharray: 1; stroke-dashoffset: calc(1 - clamp(0, (var(--p, 0) - var(--a, 0)) / 0.3, 1)); }
      #pk-ld img { opacity: 0; transition: opacity 300ms ease; }
      #pk-ld.full img { opacity: 1; }
      #pk-ld.out { opacity: 0; }
      #pk-ld .pk-ld-n { font: 500 14px/1 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .08em; color: #262654;
        font-variant-numeric: tabular-nums; }
      @media (prefers-reduced-motion: reduce) {
        #pk-ld path { stroke-dasharray: none; stroke-dashoffset: 0; }
        #pk-ld img { opacity: 1; }
        #pk-ld, #pk-ld img { transition: none; }
      }
    </style>
  </head>
  <body class:list={['flex min-h-dvh flex-col', theme === 'night' ? 'theme-night bg-night bg-night-grain text-sand' : 'bg-sand bg-sand-tex text-navy']}>
    <a href="#main" class="sr-only z-50 bg-navy px-6 py-4 text-sand focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <Loader />
    <SiteNav theme={theme} current={current} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/motion';</script>
  </body>
</html>
