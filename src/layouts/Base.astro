---
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import type { NavKey } from '../data/site';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'night';
  current?: NavKey;
}
const {
  title,
  description = 'P.K. Sompura, temple architects and contractors in Palitana, Gujarat. Hand carving, CNC stone work and artificial mountain temples.',
  theme = 'light',
  current,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'night' ? '#0E0E1F' : '#F4EFE6'} />
    <link rel="icon" type="image/webp" href="/logo.webp" />
  </head>
  <body class:list={['flex min-h-dvh flex-col', theme === 'night' ? 'theme-night bg-night bg-night-grain text-sand' : 'bg-sand bg-sand-tex text-navy']}>
    <a href="#main" class="sr-only z-50 bg-navy px-6 py-4 text-sand focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <SiteNav theme={theme} current={current} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/motion';</script>
  </body>
</html>
