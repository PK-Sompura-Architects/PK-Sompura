---
import Base from '../../layouts/Base.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import TypeCard from '../../components/TypeCard.astro';
import { SCOPES, pad, placeFull, sortedProjects } from '../../lib/projects';

// Phase 2: the full list as static HTML, in the default order (place A–Z). Phase 3 adds the filter bar and sort.
const projects = await sortedProjects();
const count = `Showing ${projects.length} of ${projects.length} entries · over 51 projects completed`;
const cols = 'grid-cols-[48px_minmax(0,1fr)_200px_132px_32px] xl:grid-cols-[56px_minmax(0,1fr)_220px_180px_132px_64px_32px]';
---
<Base title="Temple Register · P.K. Sompura" current="register">
  <header class="wrap grid-page gap-y-4 pb-8 pt-12 lg:items-end lg:pb-16 lg:pt-[120px]">
    <div class="col-span-4 flex flex-col gap-[18px] md:col-span-8 lg:gap-6">
      <p class="eyebrow text-slate-deep">Projects · the archive</p>
      <h1 class="text-cut font-display text-[52px] leading-[.94] lg:text-display">The Temple Register</h1>
    </div>
    <p class="col-span-4 max-w-[60ch] text-body md:col-span-6 lg:col-span-4">Over 51 projects completed. The register lists the documented ones; more are being added.</p>
  </header>

  <div class="wrap pb-24 lg:pb-40">
    <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-navy py-3 font-mono text-[12px] text-slate-deep lg:border-b-0 lg:border-t lg:py-3.5 lg:text-[13px]">
      <span>{count}</span>
      <span class="max-lg:hidden">Scope marks, left to right: Design · Hand carving · CNC · Construction · Fero</span>
    </div>

    <!-- Desktop: each row is one link. The navy band is the reduced-motion state of Flowing Menu; phase 4 adds the slide and loop. -->
    <div class="max-lg:hidden">
      <div class={`grid ${cols} gap-x-6 border-b border-navy py-2.5 font-mono text-[11px] font-medium uppercase tracking-[.08em] text-slate-deep`} aria-hidden="true">
        <span>No.</span><span>Name</span><span>Place</span><span class="max-xl:hidden">Type</span><span>Scope</span><span class="max-xl:hidden">Photo</span><span></span>
      </div>
      <ol>
        {projects.map((e) => {
          const p = e.data;
          return (
            <li>
              <a href={`/projects/${e.id}`} class="register-row group relative block h-24 overflow-hidden border-b border-slate focus-visible:outline-none">
                <span class={`absolute inset-0 grid ${cols} items-center gap-x-6`}>
                  <span class="font-mono text-[13px] text-slate-deep">{pad(p.no)}</span>
                  <span class="truncate font-display text-title">{p.name}</span>
                  <span class="font-mono text-[14px]">{placeFull(p)}</span>
                  <span class="font-mono text-[14px] text-slate-deep max-xl:hidden">{p.type}</span>
                  <span class="flex gap-1.5" aria-hidden="true">
                    {SCOPES.map((s) => <span class:list={['h-3 w-3 border', p.scope.includes(s) ? 'border-navy bg-navy' : 'border-slate']}></span>)}
                  </span>
                  <span class="font-mono text-[13px] text-slate-deep max-xl:hidden">{p.photos.length ? 'Photo' : '—'}</span>
                  <span class="text-right text-[20px]" aria-hidden="true">→</span>
                  <span class="sr-only">{p.type}. Scope: {p.scope.join(', ')}.{p.photos.length ? '' : ' No photographs yet.'}</span>
                </span>
                <span class="band absolute inset-0 hidden items-center gap-7 whitespace-nowrap bg-navy pl-20 group-hover:flex group-focus-visible:flex" aria-hidden="true">
                  <span class="font-display text-title text-sand">{p.name}</span>
                  <span class="h-[9px] w-[9px] flex-none rotate-45 bg-saffron"></span>
                  <span class="font-mono text-[14px] text-sky">{placeFull(p)}</span>
                  {p.photos.length > 0 && <span class="ph-night h-[72px] w-14 flex-none rounded-t-full border border-sky"></span>}
                  <span class="font-mono text-[14px] text-sky">{p.type}</span>
                  <span class="h-[9px] w-[9px] flex-none rotate-45 bg-saffron"></span>
                  <span class="font-mono text-[14px] uppercase tracking-[.06em] text-sand">{p.scope.join(' · ')}</span>
                  <span class="h-[9px] w-[9px] flex-none rotate-45 bg-saffron"></span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>

    <!-- Mobile: tap a row to expand it (native <details>; phase 4 adds the height animation). -->
    <ol class="lg:hidden">
      {projects.map((e) => {
        const p = e.data;
        return (
          <li class="border-b border-slate">
            <details class="group">
              <summary class="flex min-h-[76px] cursor-pointer list-none items-center gap-3 py-3.5 [&::-webkit-details-marker]:hidden">
                <span class="w-6 flex-none font-mono text-[12px] text-slate-deep">{pad(p.no)}</span>
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class="font-display text-[24px] leading-[1.1]">{p.name}</span>
                  <span class="font-mono text-[12px] text-slate-deep">{placeFull(p)}</span>
                </span>
                <span class="flex h-11 w-11 flex-none items-center justify-center font-mono text-[22px]" aria-hidden="true">
                  <span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span>
                </span>
              </summary>
              <div class="flex flex-col gap-4 pb-6">
                {p.photos.length > 0 ? (
                  <>
                    <PhotoFrame shape="arch" frame="h-[340px]" label={`${p.name}${p.place ? `, ${p.place}` : ''}`} />
                    <dl class="grid grid-cols-[72px_1fr] gap-x-3 gap-y-2 font-mono text-[12px] leading-normal">
                      <dt class="uppercase tracking-[.08em] text-slate-deep">Type</dt><dd>{p.type}</dd>
                      <dt class="uppercase tracking-[.08em] text-slate-deep">Scope</dt><dd>{p.scope.join(' · ')}</dd>
                    </dl>
                  </>
                ) : (
                  <TypeCard project={e} />
                )}
                <a href={`/projects/${e.id}`} class="flex h-12 items-center justify-between border border-navy px-4 text-[15px] font-medium">Open project<span aria-hidden="true">→</span></a>
              </div>
            </details>
          </li>
        );
      })}
    </ol>
  </div>
</Base>

<style>
  /* Keyboard focus on a row: sand outline inset on the navy band (12.33:1). */
  .register-row:focus-visible .band { outline: 2px solid theme('colors.sand'); outline-offset: -6px; }
</style>
