---
import Base from '../../layouts/Base.astro';
import RegisterBrowser, { type Entry } from '../../components/RegisterBrowser';
import { placeFull, sortedProjects } from '../../lib/projects';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const entries: Entry[] = (await sortedProjects()).map(({ id, data: p }) => ({
  id,
  no: p.no,
  name: p.name,
  placeFull: placeFull(p),
  placeKey: p.place ? slug(p.place) : 'to-confirm',
  type: p.type,
  scope: p.scope,
  lead: p.photos[0]?.src,
}));
---
<Base title="Temple Register · P.K. Sompura" current="register"
  description="The Temple Register: projects by P.K. Sompura, temple architects and contractors in Palitana, Gujarat. Over 51 projects completed.">
  <header class="wrap grid-page gap-y-4 pb-8 pt-12 lg:items-end lg:pb-16 lg:pt-[120px]">
    <div class="col-span-4 flex flex-col gap-[18px] md:col-span-8 lg:gap-6">
      <p class="eyebrow text-slate-deep">Projects · the archive</p>
      <h1 class="text-cut font-display text-[52px] leading-[.94] lg:text-display">The Temple Register</h1>
    </div>
    <p class="col-span-4 max-w-[60ch] text-body md:col-span-6 lg:col-span-4">Over 51 projects completed. The register lists the documented ones; more are being added.</p>
  </header>

  <div class="wrap pb-24 lg:pb-40">
    <RegisterBrowser client:idle entries={entries} />
  </div>
</Base>

<style is:global>
  /* Keyboard focus on a register row: sand outline inset on the navy band (12.33:1). */
  .register-row:focus-visible .band { outline: 2px solid theme('colors.sand'); outline-offset: -6px; }
</style>
