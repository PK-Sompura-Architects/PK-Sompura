---
import Base from '../../layouts/Base.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import ScopeTag from '../../components/ScopeTag.astro';
import Lightbox from '../../components/Lightbox.astro';
import { pad, placeFull, placeType, sortedProjects, type Project } from '../../lib/projects';
import { contact } from '../../data/site';
import { mediaFull, mediaSet } from '../../lib/media';

export async function getStaticPaths() {
  const all = await sortedProjects();
  // Prev / next follow the register's default order (place A–Z), not dates.
  return all.map((project, i) => {
    const { type, place } = project.data;
    // Related: same type first, then same place.
    const others = all.filter((o) => o.id !== project.id);
    const related = [
      ...others.filter((o) => o.data.type === type),
      ...others.filter((o) => o.data.type !== type && place && o.data.place === place),
    ].slice(0, 3);
    return { params: { slug: project.id }, props: { project, prev: all[i - 1], next: all[i + 1], related } };
  });
}

interface Props { project: Project; prev?: Project; next?: Project; related: Project[] }
const { project, prev, next, related } = Astro.props;
const p = project.data;
// Every project in the register has at least one photo of the finished temple (the register rule, Phase 3).
const finished = p.photos.filter((ph) => ph.src && !ph.construction);
const building = p.photos.filter((ph) => ph.src && ph.construction);
const [lead, ...more] = finished;
// Layout by the number of finished photos: A 1 (detail crops), B 2–3 (stacked right), C 4+ (gallery below).
const layout = finished.length === 1 ? 'A' : finished.length <= 3 ? 'B' : 'C';
const details = layout === 'A' ? (p.details ?? []) : [];
// Lightbox order: the photos as they appear on the page.
const shown = [lead, ...details, ...more, ...building].filter((ph) => ph?.src) as { src: string; label: string }[];
const lb = (src: string) => shown.findIndex((ph) => ph.src === src);
// The lead photo is the page's LCP: preloaded with the same srcset and sizes the PhotoFrame below uses.
const LEAD_SIZES = '(min-width: 1024px) 50vw, (min-width: 768px) calc(100vw - 80px), calc(100vw - 40px)'; // inside the page gutters
const leadSet = mediaSet(lead.src);
const place = placeFull(p);
---
<Base title={`${p.name}${p.place && p.place !== p.name ? `, ${p.place}` : ''} · Temple Register · P.K. Sompura`} current="register"
  preload={leadSet ? { srcset: leadSet.avif, sizes: LEAD_SIZES } : undefined}
  image={`/og/projects/${project.id}.jpg`} imageAlt={`${[p.name, place].filter(Boolean).join(', ')}: ${p.type}`}
  description={`${[p.name, place].filter(Boolean).join(', ')}. ${p.type} in the Temple Register of P.K. Sompura, temple architects and contractors.`}>
  <nav aria-label="Breadcrumb" class="wrap pt-6 font-mono text-[12px] text-slate-deep lg:pt-16 lg:text-[13px]">
    <a href="/projects" class="inline-flex min-h-11 items-center text-navy underline underline-offset-4 hover:text-saffron-text">Temple Register</a>
    <span class="mx-2.5" aria-hidden="true">/</span><span>{p.place || p.name}<span class="max-lg:hidden">{p.place && `, ${p.state}`}</span></span>
  </nav>

  <header class="wrap flex flex-col gap-4 pb-8 pt-7 lg:gap-6 lg:pb-16 lg:pt-12">
    <p class="eyebrow text-slate-deep">Register entry · No. {pad(p.no)}</p>
    <h1 class="text-cut font-display text-[clamp(40px,13vw,52px)] leading-[.94] lg:text-display">{p.name}</h1>
  </header>

  <!-- Lead photo left; on the right the facts, the text, then detail tiles (A) or the other photos (B).
       Mobile stacks: lead → facts → text → details / photos → gallery → related → call to action. -->
  <div class="wrap grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-x-6">
    <div class="lg:col-span-7">
      <a href={mediaFull(lead.src!)} data-lb={lb(lead.src!)} class="block" aria-label={`Open photo: ${lead.label}`}>
        <PhotoFrame priority reveal glare shape="arch" frame={layout === 'A' ? 'aspect-[8/11] lg:aspect-[3/4]' : 'aspect-[8/11] lg:aspect-[4/5]'}
          sizes={LEAD_SIZES} label={lead.label} src={lead.src} />
      </a>
    </div>
    <div class="flex flex-col gap-8 lg:col-span-4 lg:col-start-9 lg:gap-10">
      <dl class="grid grid-cols-[64px_1fr] gap-x-3 gap-y-2.5 text-[15px] lg:flex lg:flex-col lg:gap-0 lg:text-[17px]">
        {p.place && <div class="contents lg:grid lg:grid-cols-[88px_1fr] lg:gap-4 lg:border-t lg:border-slate lg:py-3.5"><dt class="font-mono text-[12px] uppercase tracking-[.08em] text-slate-deep">Place</dt><dd>{place}</dd></div>}
        <div class="contents lg:grid lg:grid-cols-[88px_1fr] lg:gap-4 lg:border-t lg:border-slate lg:py-3.5"><dt class="font-mono text-[12px] uppercase tracking-[.08em] text-slate-deep">Type</dt><dd>{p.type}</dd></div>
        <div class="contents lg:grid lg:grid-cols-[88px_1fr] lg:gap-4 lg:border-y lg:border-slate lg:py-3.5"><dt class="font-mono text-[12px] uppercase tracking-[.08em] text-slate-deep">Scope</dt>
          <dd><span class="lg:hidden">{p.scope.join(' · ')}</span><span class="flex flex-wrap gap-1.5 max-lg:hidden">{p.scope.map((s) => <ScopeTag label={s} size="sm" />)}</span></dd></div>
      </dl>
      {p.text && <p class="max-w-[46ch] text-body">{p.text}</p>}
      {details.length > 0 && (
        <div class="grid grid-cols-2 gap-3 lg:gap-4">
          {details.map((d) => (
            <a href={mediaFull(d.src)} data-lb={lb(d.src)} class="block" aria-label={`Open photo: ${d.label}`}>
              <PhotoFrame reveal glare frame="aspect-square" sizes="(min-width: 1024px) 16vw, 45vw" label={d.label} src={d.src} caption="Detail" />
            </a>
          ))}
        </div>
      )}
      {layout === 'B' && more.map((ph) => (
        <a href={mediaFull(ph.src!)} data-lb={lb(ph.src!)} class="block" aria-label={`Open photo: ${ph.label}`}>
          <PhotoFrame reveal glare frame="aspect-[4/3]" sizes="(min-width: 1024px) 30vw, calc(100vw - 40px)" label={ph.label} src={ph.src} />
        </a>
      ))}
    </div>
  </div>

  {layout === 'C' && (
    <section class="wrap mt-14 lg:mt-24" aria-label="Photographs">
      <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-6">
        {more.map((ph) => (
          <li><a href={mediaFull(ph.src!)} data-lb={lb(ph.src!)} class="block" aria-label={`Open photo: ${ph.label}`}>
            <PhotoFrame reveal glare frame="aspect-[4/3]" sizes="(min-width: 768px) 30vw, 45vw" label={ph.label} src={ph.src} />
          </a></li>
        ))}
      </ul>
    </section>
  )}

  {building.length > 0 && (
    <section class="wrap mt-14 lg:mt-24" aria-labelledby="building-title">
      <h2 id="building-title" class="eyebrow mb-4 border-b border-slate pb-3 text-slate-deep lg:mb-6">During construction</h2>
      <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 lg:gap-6">
        {building.map((ph) => (
          <li><a href={mediaFull(ph.src!)} data-lb={lb(ph.src!)} class="block" aria-label={`Open photo: ${ph.label}`}>
            <PhotoFrame reveal frame="aspect-[4/3]" sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw" label={ph.label} src={ph.src} />
          </a></li>
        ))}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="wrap mt-14 lg:mt-24" aria-labelledby="related-title">
      <div class="mb-4 flex items-baseline justify-between gap-6 border-b border-navy pb-3 lg:mb-6">
        <h2 id="related-title" class="font-display text-[30px] leading-[1.1] lg:text-[44px]">More {p.type.toLowerCase()}s</h2>
        <a href="/projects?sort=type" class="text-link inline-flex min-h-11 items-center whitespace-nowrap text-[15px] max-lg:hidden">See all by type →</a>
      </div>
      <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {related.map((r) => (
          <li>
            <a href={`/projects/${r.id}`} class="group flex gap-4 md:flex-col md:gap-3">
              <PhotoFrame class="w-28 flex-none md:w-full" frame="aspect-[4/5] md:aspect-[4/3]" sizes="(min-width: 768px) 30vw, 112px"
                label={r.data.photos[0]?.label ?? r.data.name} src={r.data.photos.find((ph) => !ph.construction)?.src} />
              <span class="flex flex-col gap-1 self-center md:self-start">
                <span class="font-display text-[22px] leading-[1.15] group-hover:text-saffron-text lg:text-[28px]">{r.data.name}</span>
                <span class="font-mono text-[12px] text-slate-deep lg:text-[13px]">{placeType(r.data)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Closing call to action on every project page. -->
  <section class="wrap mt-16 lg:mt-36" aria-labelledby="plan-title">
    <div class="flex flex-col gap-5 bg-stone bg-stone-tex px-5 py-8 shadow-tablet lg:flex-row lg:items-center lg:justify-between lg:gap-10 lg:px-16 lg:py-14">
      <div class="flex flex-col gap-3 lg:gap-4">
        <h2 id="plan-title" class="text-cut font-display text-[34px] leading-[1.05] lg:text-[56px]">Planning a temple?</h2>
        <p class="max-w-[46ch] text-[16px] leading-[1.55] lg:text-[18px]">Talk to the workshop in Palitana about design, carving and construction.</p>
      </div>
      <div class="flex flex-col gap-3 md:flex-row lg:flex-none">
        <a href={contact.phoneHref} class="btn-primary">Call {contact.phone}</a>
        <a href={contact.whatsappHref} class="btn-secondary">WhatsApp</a>
      </div>
    </div>
  </section>

  <nav aria-label="More projects" class="wrap mt-12 flex flex-col gap-4 border-t border-navy pb-24 pt-6 lg:mt-24 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-6 lg:pb-40 lg:pt-8">
    <div>
      {prev && (
        <a href={`/projects/${prev.id}`} class="group flex min-h-14 flex-col gap-1 lg:gap-2">
          <span class="font-mono text-[12px] text-slate-deep lg:uppercase lg:tracking-[.08em]">← Previous<span class="max-lg:hidden"> · by place</span></span>
          <span class="font-display text-[24px] group-hover:text-saffron-text lg:text-[36px]">{prev.data.name}</span>
          <span class="font-mono text-[13px] text-slate-deep max-lg:hidden">{placeType(prev.data)}</span>
        </a>
      )}
    </div>
    <a href="/projects" class="btn-secondary order-last h-[52px] lg:order-none lg:h-12 lg:px-5 lg:text-[15px]">Back to the register</a>
    <div>
      {next && (
        <a href={`/projects/${next.id}`} class="group flex min-h-14 flex-col items-end gap-1 text-right lg:gap-2">
          <span class="font-mono text-[12px] text-slate-deep lg:uppercase lg:tracking-[.08em]">Next<span class="max-lg:hidden"> · by place</span> →</span>
          <span class="font-display text-[24px] group-hover:text-saffron-text lg:text-[36px]">{next.data.name}</span>
          <span class="font-mono text-[13px] text-slate-deep max-lg:hidden">{placeType(next.data)}</span>
        </a>
      )}
    </div>
  </nav>

  <Lightbox photos={shown.map((ph) => ({ src: mediaFull(ph.src), alt: ph.label }))} />
</Base>
