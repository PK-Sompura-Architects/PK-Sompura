---
import Base from '../layouts/Base.astro';
import PosterFrame from '../components/PosterFrame.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import ScopeTag from '../components/ScopeTag.astro';
import Ambient from '../components/Ambient';
import FeroFlight from '../components/FeroFlight.astro';
import CncCut from '../components/CncCut.astro';
import { getCollection } from 'astro:content';
import { contact } from '../data/site';
import { placeFull } from '../lib/projects';

// §7 order as on Board 01.
const featuredOrder = ['vaishno-devi-gulbarga', 'godiji-derasar', 'digambar-jain-derasar', 'gelmata', 'hastgiri', 'kachhi-bhavan-palitana'];
const featured = (await getCollection('projects', (p) => p.data.featured))
  .sort((a, b) => featuredOrder.indexOf(a.id) - featuredOrder.indexOf(b.id));

const plates = [
  { n: '01', title: 'Sketch', caption: 'Pencil elevations of the mountain.', photo: 'Pencil mountain elevations · FERO folder', src: 'fero-sketch' },
  { n: '02', title: 'Model', caption: 'A painted model of the mountain and its shrines.', photo: 'Painted mountain model · NIKON DSCN2429–2438', src: 'fero-model' },
  { n: '03', title: 'Foundation', caption: 'Vaishno Devi, Gulbarga, Karnataka.', photo: 'Gulbarga build sequence · foundation', src: 'fero-foundation' },
  { n: '04', title: 'Rock shell', caption: 'Vaishno Devi, Gulbarga, Karnataka.', photo: 'Gulbarga build sequence · rock shell', src: 'fero-shell' },
  { n: '05', title: 'The finished temple', caption: 'Vaishno Devi, Gulbarga, Karnataka.', photo: 'Gulbarga mountain temple, evening', src: 'fero-finished' },
];
const cncPhotos = [
  { label: 'CNC machine, workshop · DSCN2396, turned upright, date stamp removed', caption: 'In the workshop', src: 'cnc-machine-1' },
  { label: 'CNC machine · DSCN2402–2403, upright', caption: 'In the workshop', src: 'cnc-machine-2' },
  { label: 'CNC-cut panel, detail', caption: 'A CNC-cut panel', src: 'cnc-panel' },
];
---
<Base title="P.K. Sompura · Temple Architect & Contractor, Palitana">

  <!-- §1 Hero: the carved panel -->
  <section aria-labelledby="hero-title" class="lg:wrap lg:grid lg:grid-cols-12 lg:gap-x-6">
    <div class="flex flex-col gap-6 px-5 pb-10 pt-8 md:px-10 lg:col-span-6 lg:justify-center lg:gap-9 lg:px-0 lg:py-10">
      <p class="eyebrow text-slate-deep">Temple Architect &amp; Contractor<br class="lg:hidden" /><span class="max-lg:hidden"> · </span>Palitana, Gujarat</p>
      <h1 id="hero-title" class="text-cut font-display text-display">Where<br />Devotion<br />Meets Stone.</h1>
      <p class="max-w-[470px] text-lead">A family practice of temple architects and contractors, three generations in Palitana, Gujarat.</p>
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-7">
        <a href="/projects" class="btn-primary">See the Temple Register</a>
        <a href="/contact" class="btn-secondary md:hidden">Contact the workshop</a>
        <a href="/contact" class="text-link max-md:hidden">Contact the workshop →</a>
      </div>
    </div>
    <PosterFrame
      name="hero"
      priority
      alt="A carved stone panel under low raking light"
      sizes="(min-width: 1440px) 720px, 50vw"
      class="aspect-[4/5] w-full lg:col-span-6 lg:w-auto lg:aspect-auto lg:h-[min(812px,calc(100svh-88px))] lg:min-h-[600px] lg:-mr-12 xl:mr-[calc(-80px-max(0px,(100vw-1440px)/2))]"
    />
  </section>

  <!-- §2 The family -->
  <section aria-label="The family" class="wrap section-y grid-page gap-y-5">
    <p class="eyebrow col-span-4 text-slate-deep md:col-span-8 lg:col-span-3 lg:pt-3.5">The family</p>
    <p data-scroll-reveal class="col-span-4 font-display text-statement md:col-span-8 lg:col-span-9">
      Three generations of one family have designed and built temples from Palitana, Gujarat, drawing each one, carving its stone by hand and by machine, and raising it on site.
    </p>
  </section>

  <!-- §3 Numbers -->
  <section aria-label="In numbers" class="bg-stone bg-stone-tex">
    <dl class="wrap grid py-14 lg:grid-cols-3 lg:py-32">
      {[['3', 'Generations'], ['51+', 'Projects completed'], ['5', 'CNC machines, owned']].map(([v, label], i) => (
        <div class:list={['flex flex-row-reverse items-end justify-between gap-4 py-6 lg:flex-col-reverse lg:items-start lg:justify-end lg:gap-5 lg:py-0',
          i > 0 && 'border-t border-slate-deep lg:border-l lg:border-t-0', i === 0 ? 'lg:pr-10' : i === 1 ? 'lg:px-10' : 'lg:pl-10']}>
          <dt class="eyebrow max-w-[9rem] pb-1.5 text-right text-navy lg:max-w-none lg:pb-0 lg:text-left">{label}</dt>
          <dd class="text-cut font-display text-stat"><span data-count={parseInt(v)}>{parseInt(v)}</span>{v.replace(/\d+/, '')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- §4 Stone Works -->
  <section id="stone-works" aria-labelledby="stone-title" class="wrap section-y scroll-mt-16 lg:scroll-mt-0">
    <div class="grid-page gap-y-6">
      <div class="col-span-4 flex flex-col gap-6 md:col-span-8 lg:col-span-7">
        <p class="eyebrow text-slate-deep">Line of work 01 / 03</p>
        <h2 id="stone-title" data-masked class="text-cut font-display text-display-xl">Stone<br class="lg:hidden" /> Works</h2>
      </div>
      <div class="col-span-4 flex flex-col gap-6 md:col-span-6 lg:col-span-4 lg:col-start-9 lg:self-end lg:pb-3">
        <p class="max-w-[60ch] text-body">Hand carving in sandstone and marble, set out to the geometry of the Shilpa Shastra.</p>
        <div class="flex flex-wrap gap-2"><ScopeTag label="Hand carving" /><ScopeTag label="Sandstone" /><ScopeTag label="Marble" /></div>
      </div>
    </div>
    <div class="grid-page mt-10 gap-y-6 lg:mt-24">
      <div class="col-span-4 md:col-span-6 lg:col-span-6">
        <PhotoFrame reveal glare shape="arch" frame="aspect-[3/4] lg:aspect-[4/5]" src="stone-sandstone" label="Hand-carved sandstone panel, close-up, raking daylight · Stone Works archive [A10]" caption="Sandstone panel, hand carved" />
      </div>
      <div class="col-span-4 flex flex-col gap-6 md:col-span-6 lg:col-span-5 lg:col-start-8 lg:gap-16 lg:pt-40">
        <div class="max-lg:hidden"><PhotoFrame reveal glare frame="aspect-[13/10]" src="stone-marble" sizes="(min-width: 1024px) 40vw, 100vw" label="Marble carving, detail · Stone Works archive [A10]" caption="Marble, hand carved" /></div>
        <PhotoFrame reveal glare frame="aspect-[4/3] lg:aspect-[3/2]" src="stone-temple" label="Finished stone temple · NIKON DSCN2489–2500" caption="A finished stone temple" />
      </div>
    </div>
  </section>

  <!-- §5 CNC Works -->
  <section id="cnc-works" aria-labelledby="cnc-title" class="relative section-y scroll-mt-16 overflow-clip lg:scroll-mt-0">
    <div data-ambient class="bg-waves pointer-events-none absolute left-0 top-0 h-[300px] w-full lg:h-[560px] lg:w-[900px]" aria-hidden="true"><div class="motion-only absolute inset-0"><Ambient client:visible kind="waves" /></div></div>
    <div class="wrap relative grid-page gap-y-6">
      <div class="col-span-4 flex flex-col gap-6 md:col-span-8 lg:col-span-7">
        <p class="eyebrow text-navy">Line of work 02 / 03</p>
        <h2 id="cnc-title" data-split class="text-cut font-display text-display-xl">CNC<br class="lg:hidden" /> Works</h2>
      </div>
      <div class="col-span-4 flex flex-col gap-6 md:col-span-6 lg:col-span-4 lg:col-start-9 lg:self-end lg:pb-3">
        <p class="max-w-[60ch] text-body">Five CNC machines, owned by the firm, cut stone panels in the workshop at Palitana.</p>
        <div class="flex flex-wrap gap-2 max-lg:hidden"><ScopeTag label="CNC" /></div>
      </div>
    </div>
    <CncCut />
    <div class="relative mt-8 lg:wrap lg:mt-24">
      <ul class="flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 [scrollbar-width:none] md:px-10 lg:grid lg:grid-cols-12 lg:gap-6 lg:overflow-visible lg:px-0" aria-label="In the workshop">
        {cncPhotos.map((p) => (
          <li class="w-[260px] flex-none snap-start lg:col-span-4 lg:w-auto">
            <PhotoFrame frame="aspect-[13/17] lg:aspect-[3/4]" src={p.src} sizes="(min-width: 1024px) 30vw, 70vw" label={p.label} caption={p.caption} captionClass="max-lg:hidden" />
          </li>
        ))}
      </ul>
      <p class="px-5 pt-3 font-mono text-[12px] text-slate-deep md:px-10 lg:hidden">In the workshop · swipe for more</p>
    </div>
  </section>

  <!-- §6 Fero Works: the mountain (night) -->
  <section id="fero-works" aria-labelledby="fero-title" class="theme-night relative scroll-mt-16 overflow-clip bg-night text-sand lg:scroll-mt-0">
    <div data-ambient class="bg-topo pointer-events-none absolute inset-0" aria-hidden="true"><div class="motion-only absolute inset-0"><Ambient client:visible kind="topo" /></div></div>
    <div class="bg-night-grain pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <FeroFlight plate={plates[0]} />
    <div class="wrap relative flex flex-col gap-4 pb-24 pt-18 lg:gap-6 lg:pb-44 lg:pt-36">
      <div class="mb-4 flex flex-col gap-4 lg:mb-12 lg:w-7/12">
        <p class="eyebrow text-sky">The build sequence<span class="max-lg:hidden"> · Vaishno Devi</span>, Gulbarga</p>
        <h3 class="font-display text-h3">From sketch to shikhara</h3>
      </div>
      <ol data-stack class="flex flex-col gap-4 lg:gap-[max(24px,calc(70vh-440px))]">
        {plates.map((p) => (
          <li class="flex flex-col gap-3.5 border-t border-slate bg-navy p-5 shadow-plate lg:sticky lg:top-[120px] lg:grid lg:h-[440px] lg:grid-cols-12 lg:gap-x-6 lg:p-10">
            <div class="flex items-baseline justify-between gap-3 lg:col-span-5 lg:flex-col-reverse lg:items-start lg:justify-between">
              <div class="flex flex-col gap-3.5">
                <h4 class="font-display text-h4">{p.title}</h4>
                <p class="text-[17px] leading-[1.55] text-sky max-lg:hidden">{p.caption}</p>
              </div>
              <span class="flex-none font-mono text-[12px] font-medium tracking-[.08em] text-sky lg:text-[13px]">{p.n} / 05</span>
            </div>
            <div class="lg:col-span-7 lg:h-full">
              <PhotoFrame tone="night" class="lg:h-full" frame="h-[200px] lg:h-full" src={p.src} sizes="(min-width: 1024px) 50vw, 100vw" label={p.photo} />
            </div>
            <p class="text-[15px] leading-normal text-sky lg:hidden">{p.caption}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- §7 Selected projects -->
  <section aria-labelledby="selected-title" class="wrap section-y flex flex-col gap-5 lg:gap-22">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <div class="flex min-w-0 flex-col gap-5">
        <p class="eyebrow text-slate-deep">From the Temple Register</p>
        <h2 id="selected-title" data-split class="text-cut font-display text-h2">Selected projects</h2>
      </div>
      <div class="flex flex-none flex-col items-end gap-5 pb-2.5 max-lg:hidden">
        <p class="text-[18px] text-slate-deep">Over 51 projects completed.</p>
        <a href="/projects" class="btn-secondary">Open the full register →</a>
      </div>
    </div>
    <ul class="flex flex-col lg:grid lg:grid-cols-3 lg:gap-x-6 lg:gap-y-20">
      {featured.map((f) => {
        const p = f.data;
        return (
          <li data-rise class="border-t border-slate lg:border-0">
            <a href={`/projects/${f.id}`} class="group flex items-center gap-4 py-4 lg:flex-col lg:items-stretch lg:gap-5 lg:py-0">
              <div class="w-24 flex-none lg:w-auto">
                <span class="lg:hidden"><PhotoFrame shape="arch" compact frame="h-[124px]" src={p.photos[0]?.src} sizes="96px" label={p.photos[0]?.label ?? p.name} /></span>
                <span class="max-lg:hidden"><PhotoFrame glare shape="arch" frame="aspect-[4/5]" src={p.photos[0]?.src} sizes="30vw" label={p.photos[0]?.label ?? p.name} /></span>
              </div>
              <div class="flex min-w-0 flex-1 flex-col gap-1.5 lg:gap-2.5">
                <p class="font-display text-[24px] leading-[1.08] group-hover:text-saffron-text lg:text-[36px] lg:leading-[1.05]">{p.name}</p>
                <p class="font-mono text-[12px] leading-[1.45] text-slate-deep lg:text-[13px]">{placeFull(p)}<br class="lg:hidden" /><span class="max-lg:hidden"> · </span>{p.type}</p>
                <div class="mt-1 flex flex-wrap gap-1.5 max-lg:hidden">{p.scope.map((s) => <ScopeTag label={s} size="sm" />)}</div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="mt-2 text-[16px] text-slate-deep lg:hidden">Over 51 projects completed.</p>
    <a href="/projects" class="btn-secondary lg:hidden">Open the full register →</a>
  </section>

  <!-- §8 Contact (night); the footer follows on the same ground -->
  <section aria-labelledby="contact-title" class="theme-night relative overflow-hidden bg-night text-sand">
    <div data-ambient class="bg-rays pointer-events-none absolute inset-0" aria-hidden="true"><div class="motion-only absolute inset-0"><Ambient client:visible kind="rays" /></div></div>
    <div class="bg-night-grain pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative grid-page gap-y-5 pb-22 pt-24 md:pt-32 lg:pb-36 lg:pt-44">
      <div class="col-span-4 flex flex-col gap-5 md:col-span-8 lg:col-span-6 lg:gap-7">
        <p class="eyebrow text-sky">Contact</p>
        <h2 id="contact-title" data-split class="text-cut-night font-display text-h2">Visit the workshop in Palitana.</h2>
        <p class="mb-4 max-w-[440px] text-body text-sky lg:mb-0">Call, write or send a message to talk about a temple.</p>
      </div>
      <dl class="col-span-4 flex flex-col md:col-span-8 lg:col-span-6 lg:self-end">
        {[
          ['Phone', contact.phone, contact.phoneHref],
          ['Email', contact.email, `mailto:${contact.email}`],
          ['Instagram', contact.instagram, contact.instagramHref],
        ].map(([dt, value, href]) => (
          <div class="flex flex-col gap-1.5 border-t border-slate py-[18px] lg:grid lg:grid-cols-[140px_1fr] lg:items-baseline lg:gap-6 lg:py-6">
            <dt class="eyebrow text-sky">{dt}</dt>
            <dd><a href={href} class="inline-flex min-h-11 items-center break-all font-display text-contact text-sand transition-colors hover:text-saffron lg:break-normal">{value}</a></dd>
          </div>
        ))}
        <div class="flex flex-col gap-1.5 border-y border-slate py-[18px] lg:grid lg:grid-cols-[140px_1fr] lg:items-baseline lg:gap-6 lg:py-6">
          <dt class="eyebrow text-sky">Workshop</dt>
          <dd class="text-body">[A3] Workshop street address, to be supplied<br />Palitana, Gujarat</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
