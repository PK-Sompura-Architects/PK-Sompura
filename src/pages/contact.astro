---
import Base from '../layouts/Base.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import Ambient from '../components/Ambient';
import { contact } from '../data/site';

const rows = [
  { dt: 'Phone', value: contact.phone, href: contact.phoneHref, note: 'Tap to call' },
  { dt: 'WhatsApp', value: contact.whatsapp, href: contact.whatsappHref, note: 'Opens WhatsApp with an enquiry ready to send' },
  { dt: 'Email', value: contact.email, href: `mailto:${contact.email}` },
  { dt: 'Instagram', value: contact.instagram, href: contact.instagramHref },
];
---
<Base title="Contact · P.K. Sompura" theme="night" current="contact"
  description="Call, write or message P.K. Sompura, temple architects and contractors in Palitana, Gujarat.">
  <div class="relative">
    <div data-ambient class="bg-rays pointer-events-none absolute inset-x-0 -top-22 h-[900px] [--ray-x:60%] lg:[--ray-x:62%]" aria-hidden="true"><div class="motion-only absolute inset-0"><Ambient client:media="(min-width: 1024px) and (pointer: fine)" kind="rays" /></div></div>
    <div class="wrap relative grid-page gap-y-5 pt-16 lg:gap-y-[120px] lg:pt-36">
      <div class="col-span-4 flex flex-col gap-5 md:col-span-8 lg:gap-7">
        <p class="eyebrow text-sky">Contact</p>
        <h1 class="text-cut-night font-display text-[50px] leading-[.96] lg:text-display">Visit the workshop in Palitana.</h1>
      </div>
      <p class="col-span-4 mb-3 text-body text-sky md:col-span-6 lg:col-span-4 lg:mb-0 lg:self-end">Call, write or send a message to talk about a temple.</p>

      <!-- Label + value rows. The rule is each row's own bottom border (never drawn over the text); labels line up
           through subgrid; the value cell may shrink (min-w-0) and the email wraps anywhere instead of overflowing.
           At ≤ 480 px each row stacks. -->
      <dl class="col-span-4 grid grid-cols-[auto_minmax(0,1fr)] border-t border-slate md:col-span-8 lg:col-span-9">
        {rows.map((r) => (
          <div class="col-span-2 grid grid-cols-subgrid items-baseline gap-x-6 border-b border-slate py-5 max-[480px]:flex max-[480px]:flex-col max-[480px]:gap-1.5 lg:gap-x-10 lg:py-8">
            <dt class="eyebrow text-sky">{r.dt}</dt>
            <dd class="min-w-0">
              <a href={r.href}
                class="inline-block max-w-full py-2 font-display text-[28px] leading-[1.05] text-sand transition-colors [overflow-wrap:anywhere] hover:text-saffron focus-visible:outline-sand lg:text-[clamp(32px,3vw,44px)]"
              >{r.value}</a>
              {r.note && <span class="block font-mono text-[13px] text-sky max-lg:hidden">{r.note}</span>}
            </dd>
          </div>
        ))}
        <div class="col-span-2 grid grid-cols-subgrid items-baseline gap-x-6 border-b border-slate py-5 max-[480px]:flex max-[480px]:flex-col max-[480px]:gap-1.5 lg:hidden">
          <dt class="eyebrow text-sky">Workshop</dt>
          <dd class="min-w-0 text-[16px] leading-[1.55]">{contact.address.map((l) => <span class="block">{l}</span>)}<a href={contact.mapsHref} class="text-link mt-1 inline-flex min-h-11 items-center text-sand hover:text-saffron">Open in Maps →</a></dd>
        </div>
      </dl>
    </div>

    <div class="wrap relative mt-6 lg:mt-0">
      <div class="grid-page gap-y-6 lg:border-t lg:border-slate lg:pt-14">
        <div class="col-span-4 flex flex-col gap-3.5 max-lg:hidden">
          <p class="eyebrow text-sky">The workshop</p>
          <p class="font-display text-[40px] leading-[1.1]">Palitana, Gujarat</p>
          <p class="text-[18px] leading-[1.6]">{contact.address.slice(0, 3).map((l) => <span class="block">{l}</span>)}</p>
          <a href={contact.mapsHref} class="text-link inline-flex min-h-11 w-fit items-center text-sand hover:text-saffron">Open in Maps →</a>
        </div>
        <div class="col-span-4 md:col-span-8 lg:col-span-7 lg:col-start-6">
          <PhotoFrame shape="arch" tone="night" frame="h-[300px] lg:h-[420px]" src="workshop" sizes="(min-width: 1024px) 55vw, 100vw"
            label="Workshop at Palitana, machine hall (wide shot of all five, if taken; otherwise DSCN2410–2413, no faces)"
            caption="The workshop" captionClass="max-lg:hidden" />
        </div>
      </div>
    </div>
  </div>
  <div class="h-18 lg:h-36" aria-hidden="true"></div>
</Base>
