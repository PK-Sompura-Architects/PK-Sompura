---
// Night footer (Board 01 §8, Board 04). © has no year: there are no dates anywhere on the site.
import LogoMark from './LogoMark.astro';
import { nav } from '../data/site';

---
<footer class="theme-night border-t border-slate bg-night bg-night-grain text-sand">
  <div class="wrap grid-page items-end gap-y-6 pb-10 pt-8 lg:pb-14 lg:pt-12">
    <div class="col-span-4 flex items-center gap-3.5 md:col-span-8 lg:col-span-6 lg:gap-5">
      <span class="lg:hidden"><LogoMark theme="night" size="footer-sm" /></span>
      <span class="max-lg:hidden"><LogoMark theme="night" size="footer" /></span>
      <div class="flex flex-col gap-1 lg:gap-1.5">
        <p class="font-display text-[22px] leading-tight lg:text-[28px]">P.K. Sompura</p>
        <p class="font-mono text-[12px] leading-normal text-sky lg:tracking-[.06em]">
          Temple Architect &amp; Contractor<span class="max-lg:hidden"> · Palitana, Gujarat</span>
        </p>
      </div>
    </div>

    <div class="col-span-4 flex flex-col gap-6 md:col-span-8 lg:col-span-6 lg:items-end lg:gap-4">
      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-4 text-[15px] font-medium lg:flex lg:gap-7">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-11 items-center whitespace-nowrap text-sand no-underline underline-offset-[5px] transition-colors duration-150 hover:text-saffron hover:underline">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="font-mono text-[12px] leading-normal text-sky">
        © P.K. Sompura<span class="max-lg:hidden"> · </span><br class="lg:hidden" />Where Devotion Meets Stone.
      </p>
    </div>
  </div>
</footer>
