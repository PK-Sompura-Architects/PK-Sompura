---
// Temporary page body for phase 1 only: shows the layout, nav and footer. Replaced in phase 2.
interface Props { page: string; theme?: 'light' | 'night' }
const { page, theme = 'light' } = Astro.props;
---
<section class="wrap section-y">
  <p class:list={['eyebrow', theme === 'night' ? 'text-sky' : 'text-slate-deep']}>Phase 1 shell · page content arrives in phase 2</p>
  <h1 class:list={['mt-6 font-display text-display', theme === 'night' ? 'text-cut-night' : 'text-cut']}>{page}</h1>
</section>
