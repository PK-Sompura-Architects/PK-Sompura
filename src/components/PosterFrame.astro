---
// Scene3D poster: an <img> that is always in the HTML. It is the first paint, and the fallback for no WebGL2,
// Save-Data, low memory and prefers-reduced-motion. Phase 5 mounts the three.js chunk over it.
// The poster is rendered from the real scene (tools/posters/render-3d.mjs). Only the CNC panel uses it.
interface Props {
  alt: string;
  sizes: string; // desktop sizes attribute
  class?: string;
}
const { alt, sizes, class: cls } = Astro.props;
const d = (ext: string) => [960, 1600, 2400].map((w) => `/posters/toolpath-${w}.${ext} ${w}w`).join(', ');
const m = (ext: string) => [480, 960].map((w) => `/posters/toolpath-m-${w}.${ext} ${w}w`).join(', ');
---
<div class:list={['relative overflow-hidden', cls]} data-scene="toolpath">
  <picture>
    <source media="(min-width: 1024px)" type="image/avif" srcset={d('avif')} sizes={sizes} width="2400" height="1200" />
    <source media="(min-width: 1024px)" type="image/webp" srcset={d('webp')} sizes={sizes} width="2400" height="1200" />
    <source type="image/avif" srcset={m('avif')} sizes="100vw" width="960" height="1120" />
    <source type="image/webp" srcset={m('webp')} sizes="100vw" width="960" height="1120" />
    <img
      src="/posters/toolpath-m-960.webp"
      alt={alt}
      width="960"
      height="1120"
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </picture>
</div>

<script>import '../scripts/scene3d';</script>

<style is:global>
  /* Once a scene's first frame is up, the canvas fades in over 600 ms and the poster fades out underneath. */
  [data-scene] picture img { transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  [data-3d-live] picture img { opacity: 0; }
</style>
