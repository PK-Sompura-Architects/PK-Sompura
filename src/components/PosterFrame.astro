---
// Scene3D poster: an <img> that is always in the HTML. It is the first paint, and the fallback for no WebGL2,
// Save-Data, low memory and prefers-reduced-motion. Phase 5 mounts the three.js chunk over it.
// Posters are stand-ins rendered by tools/posters/render.py until phase 5 renders them from the real scenes.
interface Props {
  name: 'hero' | 'toolpath' | 'mountain-k3';
  alt: string;
  sizes: string; // desktop sizes attribute
  priority?: boolean;
  class?: string;
}
const { name, alt, sizes, priority = false, class: cls } = Astro.props;
const dims = { hero: [2400, 1350, 960, 1200], toolpath: [2400, 1200, 960, 1120], 'mountain-k3': [2400, 1350, 960, 1494] }[name];
const d = (ext: string) => [960, 1600, 2400].map((w) => `/posters/${name}-${w}.${ext} ${w}w`).join(', ');
const m = (ext: string) => [480, 960].map((w) => `/posters/${name}-m-${w}.${ext} ${w}w`).join(', ');
---
<div class:list={['relative overflow-hidden', cls]} data-scene={name}>
  <picture>
    <source media="(min-width: 1024px)" type="image/avif" srcset={d('avif')} sizes={sizes} width={dims[0]} height={dims[1]} />
    <source media="(min-width: 1024px)" type="image/webp" srcset={d('webp')} sizes={sizes} width={dims[0]} height={dims[1]} />
    <source type="image/avif" srcset={m('avif')} sizes="100vw" width={dims[2]} height={dims[3]} />
    <source type="image/webp" srcset={m('webp')} sizes="100vw" width={dims[2]} height={dims[3]} />
    <img
      src={`/posters/${name}-m-960.webp`}
      alt={alt}
      width={dims[2]}
      height={dims[3]}
      class="absolute inset-0 h-full w-full object-cover"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  </picture>
  {name === 'mountain-k3' && (
    <div class="scene-edges pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-night to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-[10%] bg-gradient-to-t from-night to-transparent"></div>
    </div>
  )}
</div>

<script>import '../scripts/scene3d';</script>

<style is:global>
  /* Once a scene's first frame is up, the canvas fades in over 600 ms and the poster fades out underneath. */
  [data-scene] picture img { transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  [data-3d-live] picture img { opacity: 0; }
  /* Mountain edges: the poster bakes these in; over the live canvas they are drawn here, with a Gradual Blur band. */
  [data-scene] .scene-edges { display: none; z-index: 1; }
  [data-3d-live] .scene-edges { display: block; }
  [data-3d-live] .scene-edges > div { backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  [data-3d-live] .scene-edges > div:first-child { mask-image: linear-gradient(#000, transparent); -webkit-mask-image: linear-gradient(#000, transparent); }
  [data-3d-live] .scene-edges > div:last-child { mask-image: linear-gradient(transparent, #000); -webkit-mask-image: linear-gradient(transparent, #000); }
</style>
