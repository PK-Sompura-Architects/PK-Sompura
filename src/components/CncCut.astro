---
// CNC chapter: the panel drawn, not revealed. Pinned while the machine cuts it in order: 1 outer border → 2 inner
// frame and moulding lines → 3 main motif outlines → 4 fine interior detail (SVG lines, stroke-dashoffset, a glowing
// tool tip on the active path) → 5 the relief depth cuts in behind the lines in the same order (the 3D shader reads
// public/tex/cut-order.webp; without 3D the finished poster fades in). Paths and timings: tools/cnc/build.py.
// Reduced motion and no JS: no pin, the finished panel.
import PosterFrame from './PosterFrame.astro';
import cnc from '../data/cnc-paths.json';
---
<div data-cnc class="cnc relative mt-10 lg:mt-24">
  <div class="cnc-stage">
    <figure class="relative w-full lg:wrap">
      <div class="relative">
        <PosterFrame name="toolpath" alt="A carved stone panel with a rosette, cut on the CNC machine" sizes="(min-width: 1440px) 1280px, 90vw" class="aspect-[6/7] w-full md:aspect-[2/1]" />
        <div class="cnc-blank pointer-events-none absolute inset-0 bg-stone bg-stone-tex" aria-hidden="true"></div>
        <svg class="cnc-lines pointer-events-none" viewBox={cnc.viewBox} fill="none" aria-hidden="true">
          <defs><filter id="cnc-glow" x="-2" y="-2" width="5" height="5"><feGaussianBlur stdDeviation="0.7" /></filter></defs>
          {cnc.paths.map((p) => <path d={p.d} pathLength="1" data-t0={p.t0} data-t1={p.t1} data-stage={p.stage} />)}
          <g class="cnc-tip"><circle r="1.6" fill="#CD8841" filter="url(#cnc-glow)" /><circle r="0.45" fill="#CD8841" /></g>
        </svg>
      </div>
      <figcaption class="mt-3.5 font-mono text-[13px] text-slate-deep max-lg:hidden">The hero panel, cut stage by stage</figcaption>
    </figure>
  </div>
</div>

<style>
  .cnc-lines { position: absolute; left: 50%; top: 50%; height: 88%; aspect-ratio: 70.4 / 88; transform: translate(-50%, -50%); display: none; }
  .cnc-lines path { stroke: #262654; stroke-width: 0.28; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: var(--lines, 1); }
  .cnc-tip { opacity: 0; }
  .cnc-blank { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cnc { height: 260svh; }
    :global(.js) .cnc-stage { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; }
    :global(.js) .cnc-lines { display: block; }
    /* Without 3D, the lines draw on the uncut slab and the finished poster fades in for stage 5. */
    :global(.js) .cnc-blank { display: block; opacity: var(--blank, 1); }
    :global(.js) [data-3d-live] ~ .cnc-blank { display: none; }
  }
</style>
