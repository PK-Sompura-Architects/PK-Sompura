---
// CNC chapter: a line trace of one of the firm's CNC-cut sandstone panels (tools/cnc/trace.py), drawn in machine
// order on a 5 s timeline: 1 outer border 0.8 s → 2 frame and mouldings 1.0 s → 3 main motifs 1.6 s → 4 fine detail
// 1.6 s. Paths within a stage draw in parallel, slightly staggered; a saffron tool tip rides the stage's longest path.
// The drawing is the finished state. It starts when the panel is 35% in view (scrolling down into it snaps the panel
// to fill the screen once, src/scripts/snap.ts), pauses off-screen and resumes in view; Replay when finished.
// Before it starts, the outer border shows faintly on the uncut stone. No JS or reduced motion: the finished drawing.
// The panel's width is capped so panel and caption fit one screen.
import cnc from '../data/cnc-paths.json';

const [, , vw, vh] = cnc.viewBox.split(' ').map(Number);
---
<div data-cnc class="cnc wrap mt-10 lg:mt-24">
  <figure class="m-0 mx-auto flex flex-col gap-3 lg:gap-3.5" style={`max-width: calc((100svh - 128px) * ${vw / vh})`}>
    <div class="relative w-full overflow-hidden bg-stone bg-stone-tex" style={`aspect-ratio: ${vw} / ${vh}`}>
      <svg class="cnc-lines absolute inset-0 h-full w-full" viewBox={cnc.viewBox} fill="none" role="img"
        aria-label="Line drawing of a CNC-cut sandstone panel: a sheaf of stems tied with a band, a sunflower at the centre and at each end, and mirrored scrolls">
        <defs><filter id="cnc-glow" x="-2" y="-2" width="5" height="5"><feGaussianBlur stdDeviation="2" /></filter></defs>
        <path class="cnc-ghost" d={cnc.paths[0].d} />
        {cnc.paths.map((p) => <path d={p.d} pathLength="1" data-stage={p.stage} />)}
        <g class="cnc-tip"><circle r="5" fill="#CD8841" filter="url(#cnc-glow)" /><circle r="1.6" fill="#CD8841" /></g>
      </svg>
    </div>
    <figcaption class="flex min-h-11 items-start justify-between gap-4 font-mono text-[12px] text-slate-deep lg:text-[13px]">
      <span>A CNC-cut sandstone panel, drawn in the order the machine cuts it</span>
      <button type="button" class="cnc-replay" hidden>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7a4.5 4.5 0 1 0 1.3-3.2M2.5 1.5v2.8h2.8" /></svg>
        Replay
      </button>
    </figcaption>
  </figure>
</div>

<script>
  import { snap } from '../scripts/snap';
  const root = document.querySelector<HTMLElement>('[data-cnc]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const paths = [...root.querySelectorAll<SVGPathElement>('path[data-stage]')];
    const tip = root.querySelector<SVGGElement>('.cnc-tip')!;
    const replay = root.querySelector<HTMLButtonElement>('.cnc-replay')!;
    const fig = root.querySelector<HTMLElement>('figure')!;
    // Stage durations (s); each path starts within the first 35% of its stage and takes the remaining 65%.
    const STAGES: [string, number][] = [['1', 0.8], ['2', 1.0], ['3', 1.6], ['4', 1.6]];
    const STAGGER = 0.35;
    const lens = paths.map((p) => p.getTotalLength());
    const seg: { t0: number; t1: number }[] = [];
    const lead: { i: number; t0: number; t1: number }[] = []; // the path the tip rides in each stage
    let t = 0;
    for (const [st, dur] of STAGES) {
      const idx = paths.flatMap((p, i) => (p.dataset.stage === st ? [i] : []));
      idx.forEach((i, k) => {
        const t0 = t + (idx.length > 1 ? (dur * STAGGER * k) / (idx.length - 1) : 0);
        seg[i] = { t0, t1: idx.length > 1 ? t0 + dur * (1 - STAGGER) : t + dur };
      });
      const li = idx.reduce((a, i) => (lens[i] > lens[a] ? i : a), idx[0]);
      lead.push({ i: li, ...seg[li] });
      t += dur;
    }
    const TOTAL = t;

    let elapsed = 0, raf = 0, last = 0, started = false, finished = false, inView = false, wall0 = 0;
    const finish = () => {
      finished = true;
      tip.style.opacity = '0';
      root.classList.add('cnc-done');
      replay.hidden = false;
      if (import.meta.env.DEV) console.info(`[cnc] drawn: timeline ${elapsed.toFixed(2)} s, wall clock ${((performance.now() - wall0) / 1000).toFixed(2)} s`);
    };
    const draw = () => {
      for (let i = 0; i < paths.length; i++) {
        const f = Math.min(1, Math.max(0, (elapsed - seg[i].t0) / (seg[i].t1 - seg[i].t0)));
        paths[i].style.strokeDashoffset = String(1 - f);
      }
      const l = lead.find((s) => elapsed < s.t1) ?? lead[lead.length - 1];
      const f = Math.min(1, Math.max(0, (elapsed - l.t0) / (l.t1 - l.t0)));
      const pt = paths[l.i].getPointAtLength(lens[l.i] * f);
      tip.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
      tip.style.opacity = f > 0 ? '1' : '0';
      if (elapsed >= TOTAL) finish();
    };
    const frame = (now: number) => {
      raf = 0;
      elapsed = Math.min(TOTAL, elapsed + Math.min(now - (last || now), 50) / 1000); // capped: a stalled frame never skips ahead
      last = now;
      draw();
      if (!finished && inView) raf = requestAnimationFrame(frame);
    };
    const play = () => { if (!raf && !finished) { last = 0; raf = requestAnimationFrame(frame); } };
    const pause = () => { cancelAnimationFrame(raf); raf = 0; };

    root.classList.add('cnc-armed');
    // Starts (once) at 35% visible, snapping when scrolled down into; pauses off-screen, resumes back in view.
    let initial = true;
    new IntersectionObserver(([e]) => {
      const first = initial; initial = false;
      if (!e.isIntersecting) { inView = false; return pause(); }
      if (!started && e.intersectionRatio < 0.35) return;
      inView = true;
      if (!started) { started = true; wall0 = performance.now(); if (!first) snap(fig); }
      play();
    }, { threshold: [0, 0.35] }).observe(fig);
    replay.addEventListener('click', () => {
      paths.forEach((p) => (p.style.strokeDashoffset = ''));
      root.classList.remove('cnc-done');
      replay.hidden = true;
      elapsed = 0; finished = false; inView = true; wall0 = performance.now();
      play();
    });
  }
</script>

<style>
  /* Stroke weights: the border and frame heaviest, main motifs medium, fine detail lightest. */
  .cnc-lines path { stroke: #262654; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .cnc-lines path[data-stage='1'] { stroke-width: 2; }
  .cnc-lines path[data-stage='2'] { stroke-width: 1.6; }
  .cnc-lines path[data-stage='4'] { stroke: #52606b; stroke-width: 0.75; }
  .cnc-lines .cnc-ghost { display: none; }
  .cnc-tip { opacity: 0; }
  /* Armed: uncut stone, the outer border faint, every path hidden until the tool reaches it. */
  :global(.cnc-armed) .cnc-lines .cnc-ghost { display: block; opacity: 0.3; stroke-width: 2; }
  /* Gap 2 > the path's length 1, so a hidden path leaves no round-cap dot at its end. */
  :global(.cnc-armed) .cnc-lines path[data-stage] { stroke-dasharray: 1 2; stroke-dashoffset: 1; }
  .cnc-replay {
    flex: none; display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    padding: 0 14px; border: 1px solid #262654; background: #F4EFE6; color: #262654;
    font: 500 12px/1 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: 0.06em; text-transform: uppercase;
    transition: background-color 150ms ease;
  }
  .cnc-replay[hidden] { display: none; }
  .cnc-replay:hover { background: #E7DFD2; }
  .cnc-replay:focus-visible { outline: 2px solid #262654; outline-offset: 2px; }
</style>
