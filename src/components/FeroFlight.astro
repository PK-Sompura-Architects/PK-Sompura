---
// Fero Works fly-through (design/Posters.dc.html P3): a pre-rendered 8 s video (tools/fero-video/render.mjs), the P3
// camera from above the cloud deck down over the ridges into the cave mouth. Desktop 1920×1080 and portrait 1080×1920,
// each as VP9 WebM and H.264 MP4, picked by orientation; the final frame is the poster. Text is HTML, never in the video.
//   Motion: the video loads when the section comes within a screen (preload none, so never part of the first load),
//   plays once when 35% visible, pauses off-screen and resumes in view; at the end it keeps the last frame, Replay.
//   Scrolling down into it snaps the stage to fill the screen once (src/scripts/snap.ts); scrolling is never held.
//   Reduced motion or Save-Data: the final-frame poster and a Play button; nothing loads until it's pressed.
//   play() rejected: the same poster and Play button. No JS: the poster, with the full title.
// Text states (full → docked → docked + line) follow video.currentTime at P3's progress points (t / 8 s).
const line = 'An artificial mountain, built around the temple it holds.';
const alt = 'Inside the cave mouth of an artificial mountain: a white-stone Nagara temple lit in saffron';
---
<div data-fly class="fly relative">
  <div class="fly-stage relative h-[100svh] min-h-[560px] overflow-hidden">
    <picture class="fly-poster">
      <source media="(orientation: portrait)" type="image/avif" srcset="/video/fero-mobile-poster.avif" />
      <source media="(orientation: portrait)" type="image/webp" srcset="/video/fero-mobile-poster.webp" />
      <source type="image/avif" srcset="/video/fero-desktop-poster.avif" />
      <img src="/video/fero-desktop-poster.webp" alt={alt} width="1920" height="1080" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    </picture>
    <video class="fly-video absolute inset-0 h-full w-full object-cover" muted playsinline preload="none" disablepictureinpicture aria-hidden="true">
      <source media="(orientation: portrait)" src="/video/fero-mobile.webm" type="video/webm" />
      <source media="(orientation: portrait)" src="/video/fero-mobile.mp4" type="video/mp4" />
      <source src="/video/fero-desktop.webm" type="video/webm" />
      <source src="/video/fero-desktop.mp4" type="video/mp4" />
    </video>
    <!-- A night scrim over the top 38% (the fog, and the cave glow at the end), so sand text keeps 4.5:1. -->
    <div class="fly-scrim pointer-events-none absolute inset-x-0 top-0 h-[38%] bg-gradient-to-b from-night to-transparent" aria-hidden="true"></div>
    <!-- Desktop end: a soft night shade behind the full-size title, so it doesn't sit on the busy cave edge. -->
    <div class="fly-shade pointer-events-none absolute inset-0 max-lg:hidden" aria-hidden="true"></div>

    <div class="fly-text wrap absolute inset-x-0 top-0 pt-24 lg:pt-32">
      <p class="eyebrow text-sky">Line of work 03 / 03</p>
      <h2 id="fero-title" class="fly-h2 mt-5 w-fit origin-top-left font-display text-h2 text-sand lg:mt-6">Fero Works</h2>
      <p class="fly-line inset-x-5 max-w-[26rem] text-body text-sand md:inset-x-10 lg:inset-x-12 xl:inset-x-20">{line}</p>
    </div>

    <button type="button" class="fly-btn" hidden>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path class="i-play" d="M4 2.5v9l7-4.5z" /><path class="i-replay" d="M2.5 7a4.5 4.5 0 1 0 1.3-3.2M2.5 1.5v2.8h2.8" />
      </svg>
      <span>Play</span>
    </button>
  </div>
</div>

<script>
  import { snap } from '../scripts/snap';
  const fly = document.querySelector<HTMLElement>('[data-fly]');
  if (fly) {
    const stage = fly.querySelector<HTMLElement>('.fly-stage')!;
    const video = fly.querySelector<HTMLVideoElement>('video')!;
    const btn = fly.querySelector<HTMLButtonElement>('.fly-btn')!;
    const text = stage.querySelector<HTMLElement>('.fly-text')!, h2 = text.querySelector<HTMLElement>('.fly-h2')!;
    const desk = matchMedia('(min-width: 1024px)');
    const DUR = 8;
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const smooth = (a: number, b: number, x: number) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t); };
    const inOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);  // power2.inOut (quad)
    let full = 1, dockTop = 0, p = 0;
    const measure = () => {
      full = parseFloat(getComputedStyle(h2).fontSize);
      text.style.setProperty('--h2h', `${h2.offsetHeight}px`);
      text.style.setProperty('--h2y', `${h2.offsetTop}px`);
      dockTop = (desk.matches ? 88 : 64) + 16 - parseFloat(getComputedStyle(text).paddingTop);
    };
    const apply = (x: number) => {
      p = x;
      // Title: full → docked 0.10–0.18; desktop back to full 0.82–0.88 (mobile stays docked).
      let dock = inOut(clamp((x - 0.1) / 0.08));
      if (desk.matches) dock -= inOut(clamp((x - 0.82) / 0.06));
      text.style.setProperty('--ty', `${dockTop * dock}px`);
      text.style.setProperty('--s', String(1 + ((desk.matches ? 32 : 28) / full - 1) * dock));
      // The line: out 0.06–0.12, back in under the docked title 0.66–0.72.
      text.style.setProperty('--lo', String(clamp(1 - smooth(0.06, 0.12, x) + smooth(0.66, 0.72, x))));
      // Night scrim over the top 38%: in the fog (S2) and from the reveal on, so the text stays on night.
      stage.style.setProperty('--scrim', String(Math.max(smooth(0.1, 0.18, x) * (1 - smooth(0.4, 0.5, x)), smooth(0.62, 0.72, x))));
      // Shade behind the title as it returns to full size at the end (desktop).
      stage.style.setProperty('--shade', String(smooth(0.8, 0.88, x)));
    };
    const redo = () => { measure(); apply(p); };
    addEventListener('resize', redo); desk.addEventListener('change', redo);
    document.fonts?.ready.then(redo);
    redo();

    // Text follows the video frame by frame while it plays.
    const sync = () => {
      apply(clamp(video.currentTime / DUR));
      if (!video.paused && !video.ended) 'requestVideoFrameCallback' in video ? video.requestVideoFrameCallback(sync) : requestAnimationFrame(sync);
    };
    const button = (label: 'Play' | 'Replay' | null) => {
      btn.hidden = !label;
      if (label) { btn.querySelector('span')!.textContent = label; btn.dataset.kind = label.toLowerCase(); }
    };
    const posterUrl = () => `/video/fero-${matchMedia('(orientation: portrait)').matches ? 'mobile' : 'desktop'}-poster.webp`;
    const still = () => { stage.classList.add('fly-still'); video.poster = posterUrl(); apply(1); button('Play'); };
    const load = () => { if (video.preload !== 'auto') { video.preload = 'auto'; video.load(); } };
    const play = () => video.play().catch(() => { if (video.paused) still(); });

    video.addEventListener('playing', () => { stage.classList.remove('fly-still'); stage.classList.add('fly-live'); button(null); sync(); });
    video.addEventListener('ended', () => { apply(1); button('Replay'); });
    btn.addEventListener('click', () => {
      load();
      if (video.ended) video.currentTime = 0;
      play();
    });

    const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || nav.connection?.saveData) still();
    else {
      stage.classList.add('fly-motion');
      apply(0);
      // Load within a screen of the section; start at 35% visible (snapping when scrolled down into), pause off-screen,
      // resume back in view.
      const near = new IntersectionObserver(([e]) => { if (e.isIntersecting) { near.disconnect(); load(); } }, { rootMargin: '100% 0px' });
      near.observe(stage);
      let started = false, initial = true;
      new IntersectionObserver(([e]) => {
        const first = initial; initial = false;
        if (!e.isIntersecting) { if (!video.paused) video.pause(); return; }
        if (video.ended || !btn.hidden || (!started && e.intersectionRatio < 0.35)) return;
        if (!started) { started = true; if (!first) snap(stage); }
        load(); play();
      }, { threshold: [0, 0.35] }).observe(stage);
    }
  }
</script>

<style>
  .fly-text { z-index: 2; }
  .fly-line { margin-top: 0.75rem; }
  .fly-scrim { z-index: 1; opacity: 0; }
  .fly-video { opacity: 0; transition: opacity 400ms cubic-bezier(0.22, 1, 0.36, 1); }
  /* Motion: night until the video's first frame is up (it shows frame 0 once loaded), then the video. */
  :global(.js) .fly-motion:not(.fly-still) .fly-poster { display: none; }
  :global(.js) .fly-motion:not(.fly-still) .fly-video, .fly-live .fly-video { opacity: 1; }
  /* Still (reduced motion, Save-Data, or play() refused): the final-frame poster until Play; .fly-live once playing. */
  /* With JS the text follows the video (--ty, --s, --lo, --scrim from the script). */
  :global(.js) .fly-text { transform: translateY(var(--ty, 0px)); }
  :global(.js) .fly-h2 { transform: scale(var(--s, 1)); }
  :global(.js) .fly-line { position: absolute; margin: 0; top: calc(var(--h2y, 0px) + var(--h2h, 0px) * var(--s, 1) + 16px); opacity: var(--lo, 1); }
  :global(.js) .fly-scrim { opacity: var(--scrim, 0); }
  /* Ellipse centred on the title block (top left), night at its core, gone by the cave mouth. No JS: shown, as the
     poster is the end frame. */
  .fly-shade {
    z-index: 1; opacity: var(--shade, 1);
    background: radial-gradient(ellipse 46% 52% at 16% 22%, rgb(14 14 31 / 0.82), rgb(14 14 31 / 0.55) 45%, rgb(14 14 31 / 0) 100%);
  }
  .fly-btn {
    position: absolute; right: 20px; bottom: 20px; z-index: 3; display: inline-flex; align-items: center; gap: 8px; min-height: 44px;
    padding: 0 16px; border: 1px solid #F4EFE6; background: rgb(14 14 31 / 0.6); color: #F4EFE6;
    font: 500 12px/1 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: 0.06em; text-transform: uppercase;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .fly-btn[hidden] { display: none; }
  .fly-btn:hover { background: #F4EFE6; color: #0E0E1F; }
  .fly-btn:focus-visible { outline: 2px solid #CD8841; outline-offset: 2px; }
  .fly-btn .i-replay, .fly-btn[data-kind='replay'] .i-play { display: none; }
  .fly-btn[data-kind='replay'] .i-replay { display: inline; }
  @media (min-width: 1024px) { .fly-btn { right: 48px; bottom: 32px; } }
  @media (min-width: 1280px) { .fly-btn { right: 80px; } }
</style>
