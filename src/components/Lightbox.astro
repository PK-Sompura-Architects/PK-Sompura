---
// Full-screen photo viewer for a project page. A native modal <dialog>: showModal() makes the rest of the page inert
// (focus is trapped inside) and Esc closes it. Arrow keys and swipes step through the photos; focus returns to the
// photo that opened it. Links with data-lb="<index>" open it; without JavaScript they open the image file itself.
interface Props { photos: { src: string; alt: string }[] }
const { photos } = Astro.props;
---
<dialog id="lb" aria-label="Photo viewer" class="lb m-0 h-dvh max-h-none w-full max-w-none bg-night/95 p-0 text-sand backdrop:bg-night/80">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-5 py-3 font-mono text-[13px] lg:px-10">
      <span class="lb-count" aria-live="polite"></span>
      <button type="button" class="lb-close inline-flex min-h-11 items-center gap-2 px-2 uppercase tracking-[.08em]">Close <span aria-hidden="true">✕</span></button>
    </div>
    <figure class="relative m-0 flex min-h-0 flex-1 flex-col items-center justify-center gap-3 px-5 pb-5 lg:px-24">
      <img class="lb-img max-h-full min-h-0 w-auto max-w-full flex-1 object-contain" alt="" decoding="async" />
      <figcaption class="lb-cap max-w-[70ch] text-center font-mono text-[12px] leading-normal text-sky lg:text-[13px]"></figcaption>
      {photos.length > 1 && (
        <>
          <button type="button" class="lb-prev lb-nav left-1 lg:left-6" aria-label="Previous photo">←</button>
          <button type="button" class="lb-next lb-nav right-1 lg:right-6" aria-label="Next photo">→</button>
        </>
      )}
    </figure>
  </div>
  <script type="application/json" class="lb-data" set:html={JSON.stringify(photos)} />
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('#lb');
  if (dlg) {
    const photos: { src: string; alt: string }[] = JSON.parse(dlg.querySelector('.lb-data')!.textContent!);
    const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    const cap = dlg.querySelector<HTMLElement>('.lb-cap')!;
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    let i = 0, opener: HTMLElement | null = null;
    const show = (n: number) => {
      i = (n + photos.length) % photos.length;
      img.src = photos[i].src; img.alt = photos[i].alt;
      cap.textContent = photos[i].alt;
      count.textContent = `${i + 1} / ${photos.length}`;
      // fetch the neighbours so stepping is instant
      for (const k of [i + 1, i - 1]) new Image().src = photos[(k + photos.length) % photos.length].src;
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lb]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      opener = a;
      show(+a.dataset.lb!);
      dlg.showModal();
    });
    dlg.addEventListener('close', () => { opener?.focus(); img.removeAttribute('src'); });
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')?.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.lb-next')?.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      else if (e.key === 'ArrowRight') show(i + 1);
    });
    // Swipe: a mostly horizontal drag of 50 px or more.
    let x0 = 0, y0 = 0;
    dlg.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; });
    dlg.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (photos.length > 1 && Math.abs(dx) > 50 && Math.abs(dx) > 1.5 * Math.abs(dy)) show(dx < 0 ? i + 1 : i - 1);
    });
    // A click on the backdrop (outside the photo and controls) closes it.
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as Element).matches('figure')) dlg.close(); });
  }
</script>

<style>
  .lb-img { touch-action: pan-y; user-select: none; -webkit-user-drag: none; }
  .lb-nav {
    position: absolute; top: 50%; translate: 0 -50%; display: inline-flex; width: 44px; height: 44px; align-items: center;
    justify-content: center; border: 1px solid #F4EFE6; background: rgb(14 14 31 / 0.6); color: #F4EFE6; font-size: 18px;
  }
  .lb-nav:hover { background: #F4EFE6; color: #0E0E1F; }
  .lb :focus-visible { outline: 2px solid #CD8841; outline-offset: 2px; }
</style>
