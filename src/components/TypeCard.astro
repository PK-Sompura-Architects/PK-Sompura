---
// A project without photos, shown as an inscribed stone tablet. Never a grey box, never "no image".
import Dentils from './Dentils.astro';
import ScopeTag from './ScopeTag.astro';
import { pad, placeFull, type Project } from '../lib/projects';

interface Props { project: Project; size?: 'row' | 'page' }
const { project, size = 'row' } = Astro.props;
const p = project.data;
---
{size === 'row' ? (
  <div class="flex flex-col gap-4 bg-stone bg-stone-tex px-5 py-6 shadow-tablet">
    <div class="flex justify-between font-mono text-[12px] uppercase tracking-[.08em]"><span>Register entry</span><span>No. {pad(p.no)}</span></div>
    <p class="text-cut font-display text-[40px] leading-none">{p.name}</p>
    <p class="font-mono text-[13px]">{placeFull(p)} · {p.type}</p>
    <div class="flex flex-wrap gap-1.5">{p.scope.map((s) => <ScopeTag label={s} size="sm" />)}</div>
    <Dentils count={12} size={10} class="border-t border-slate-deep pt-2" />
  </div>
) : (
  <div class="flex flex-col gap-6 bg-stone bg-stone-tex px-5 py-7 shadow-tablet lg:grid lg:grid-cols-12 lg:gap-x-6 lg:gap-y-14 lg:px-18 lg:pb-14 lg:pt-20">
    <div class="flex justify-between font-mono text-[12px] font-medium uppercase tracking-[.08em] lg:col-span-12 lg:text-[13px]"><span>Register entry</span><span>No. {pad(p.no)}</span></div>
    <h1 data-masked="load" class="text-cut font-display text-[clamp(40px,13vw,72px)] leading-[.9] tracking-[-.015em] [overflow-wrap:anywhere] lg:col-span-12 lg:text-[clamp(120px,13.9vw,200px)]">{p.name}</h1>
    <dl class="grid grid-cols-[64px_1fr] gap-x-3 gap-y-2.5 border-t border-slate-deep pt-4 text-[15px] lg:col-span-12 lg:grid-cols-3 lg:gap-x-6 lg:pt-6">
      <div class="contents lg:flex lg:flex-col lg:gap-2"><dt class="font-mono text-[12px] uppercase tracking-[.08em]">Place</dt><dd class="lg:font-display lg:text-[32px]">{placeFull(p)}</dd></div>
      <div class="contents lg:flex lg:flex-col lg:gap-2"><dt class="font-mono text-[12px] uppercase tracking-[.08em]">Type</dt><dd class="lg:font-display lg:text-[32px]">{p.type}</dd></div>
      <div class="contents lg:flex lg:flex-col lg:gap-2.5"><dt class="font-mono text-[12px] uppercase tracking-[.08em]">Scope</dt>
        <dd><span class="lg:hidden">{p.scope.join(' · ')}</span><span class="flex flex-wrap gap-1.5 max-lg:hidden">{p.scope.map((s) => <ScopeTag label={s} />)}</span></dd></div>
    </dl>
    <Dentils count={12} size={10} class="lg:hidden" />
    <Dentils count={24} size={18} class="pt-2 max-lg:hidden lg:col-span-12" />
  </div>
)}
